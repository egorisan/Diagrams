# PostgreSQL
DATABASE_URL=postgresql+asyncpg://diagrams_user:diagrams_pass@localhost:5432/diagrams_db

# Секрет для подписи JWT (сгенерируйте длинную случайную строку)
JWT_SECRET_KEY=change-me-in-production

# ЮKassa — shop_id и секретный ключ из кабинета магазина
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

# Цена Pro-подписки в рублях и URL возврата после оплаты
PRO_PRICE=99.00
PAYMENT_RETURN_URL=http://localhost:5173/dashboard
