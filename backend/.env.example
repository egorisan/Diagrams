# PostgreSQL (при запуске через docker compose переопределяется — см. docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://diagrams_user:diagrams_pass@localhost:5432/diagrams_db

# Секрет для подписи JWT — обязательно замените на длинную случайную строку:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
